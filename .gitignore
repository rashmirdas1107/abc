# Dependencies
/node_modules

# Compiled output
# The build output directory for your project (defaults to 'dist' in angular.json)
/dist
/build
/tmp
/out-tsc

# Angular specific files
# Cache folders generated by the Angular CLI and related tools
.angular/cache

# Environment logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS-specific temporary files
.DS_Store
Thumbs.db

# Editor/IDE files
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
.project
.classpath

# Certificates
# Local SSL certificates should not be committed
*.pem
*.key